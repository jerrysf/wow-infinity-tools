# Public origin used for canonical URLs, sitemap and Open Graph tags.
# Required in production. Set in Vercel project settings.
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# Set to "true" to render ad slots (AdSlot components). Off by default.
# NEXT_PUBLIC_ADS_ENABLED=true
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
