{
  "slug": "druid-feral-cat",
  "name": {
    "zh": "野性猫",
    "en": "Feral Cat"
  },
  "summary": {
    "zh": "野性战斗点满猎豹输出，再用激怒在变回猎豹时找回能量，自然主义再提高 5% 伤害。",
    "en": "Full Cat Form damage in Feral Combat, then Furor to recover energy when you shift back into Cat Form and Naturalist for 5% more damage."
  },
  "classId": "druid",
  "playstyle": "raid",
  "difficulty": "beginner",
  "gameVersion": "1.60.1.70425",
